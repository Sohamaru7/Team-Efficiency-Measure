# Application
APP_NAME=Team Efficiency Measure
APP_ENV=development
DEBUG=True

# PostgreSQL connection
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=team_efficiency

# Manager AI Assistant (Phase 6) — Anthropic API
# Leave ANTHROPIC_API_KEY blank to run everything except the AI Assistant page/endpoint.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Autonomous Daily Manager (Phase 10) — off by default; enable for a real deployment.
DAILY_MANAGER_SCHEDULER_ENABLED=False
DAILY_MANAGER_RUN_HOUR=8

# Authentication (production-readiness pass). JWT_SECRET_KEY MUST be set to a real random
# value for any non-local deployment — generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Leaving it blank is fine for local dev/tests only: a random secret is generated per process,
# which invalidates every token on restart (see app/core/security.py). Never commit a real
# secret here — this file is the template, not actual configuration.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# One-time admin bootstrap (production-readiness pass) — only used on first startup, only if
# BOTH are set AND no admin account exists yet. Unset both once you have a real admin account.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Demo mode — leave False. When true, POST /api/auth/demo-login issues a full session with NO
# credentials required. Never set this to True outside of scripts/run_demo.py, which sets it
# for you automatically on its own disposable SQLite database. See README "Demo Mode".
DEMO_MODE=False
